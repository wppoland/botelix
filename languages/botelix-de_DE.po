#. Plugin Name of the plugin
#: botelix.php
msgid "Botelix - Deposit Return Scheme (Pfand, SGR, Kaucja, Zaloh)"
msgstr "Botelix - Deposit Return Scheme (Pfand, SGR, Kaucja, Zaloh)"

#. Plugin URI of the plugin
#: botelix.php
msgid "https://plogins.com/botelix/"
msgstr "https://plogins.com/botelix/"

#. Description of the plugin
#: botelix.php
msgid "Statutory container deposit scheme (DRS) calculations and checkout fees for European ecommerce (Pfand, SGR, Kaucja, Zaloh, Einwegpfand)."
msgstr "Berechnung des gesetzlichen Pfands für Getränkeverpackungen (Pfandsystem, DRS) und Gebühren an der Kasse für den europäischen E-Commerce (Pfand, SGR, Kaucja, Zaloh, Einwegpfand)."

#. Author of the plugin
#: botelix.php
msgid "WPPoland.com"
msgstr "WPPoland.com"

#. Author URI of the plugin
#: botelix.php
msgid "https://wppoland.com"
msgstr "https://wppoland.com"

#: botelix.php:48
msgid "Botelix - Deposit Return Scheme for WooCommerce requires WooCommerce to be active."
msgstr "Botelix - Deposit Return Scheme for WooCommerce setzt ein aktiviertes WooCommerce voraus."

#: src/Admin/ProductMetaBox.php:41
msgid "Deposit Return Scheme (DRS / Pfand / Kaucja)"
msgstr "Pfandsystem (DRS / Pfand / Kaucja)"

#: src/Admin/ProductMetaBox.php:43
msgid "Store default scheme"
msgstr "Standard-Pfandsystem des Shops"

#: src/Admin/ProductMetaBox.php:50
msgid "Scheme override"
msgstr "Abweichendes Pfandsystem"

#: src/Admin/ProductMetaBox.php:51
msgid "Optionally lock this product to a specific national scheme, or leave as default."
msgstr "Ordne dieses Produkt optional fest einem bestimmten nationalen Pfandsystem zu oder behalte den Standard bei."

#: src/Admin/ProductMetaBox.php:58 src/Admin/ProductMetaBox.php:129
msgid "Packaging container"
msgstr "Verpackungsart"

#: src/Admin/ProductMetaBox.php:59
msgid "Select the covered container type to add the statutory deposit at checkout."
msgstr "Wähle die pfandpflichtige Verpackungsart, um das gesetzliche Pfand an der Kasse hinzuzufügen."

#: src/Admin/ProductMetaBox.php:66 src/Admin/ProductMetaBox.php:139
msgid "Container units"
msgstr "Anzahl der Verpackungen"

#: src/Admin/ProductMetaBox.php:67
msgid "Number of covered containers in this item (e.g. 6 for a 6-pack). Defaults to 1."
msgstr "Anzahl der pfandpflichtigen Verpackungen in diesem Artikel (z. B. 6 bei einem Sechserpack). Standard ist 1."

#: src/Admin/ProductMetaBox.php:132
msgid "Leave empty to inherit the parent packaging container setting."
msgstr "Leer lassen, um die Verpackungsart des übergeordneten Produkts zu übernehmen."

#: src/Admin/ProductMetaBox.php:142
msgid "Containers in this variation."
msgstr "Verpackungen in dieser Variante."

#: src/Admin/SettingsPage.php:30
msgid "Botelix Deposit Return"
msgstr "Botelix Pfandsystem"

#: src/Admin/SettingsPage.php:31
msgid "Deposit Return (DRS)"
msgstr "Pfandsystem (DRS)"

#: src/Admin/SettingsPage.php:99
msgid "Botelix - Multi-Country Deposit Return Scheme (DRS)"
msgstr "Botelix - Pfandsysteme für mehrere Länder (DRS)"

#: src/Admin/SettingsPage.php:101
msgid "Configure statutory container deposit schemes for European ecommerce (Pfand, SGR, Kaucja, Zaloh, Visszavaltasi dij)."
