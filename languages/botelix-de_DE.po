#: src/Admin/SettingsPage.php:110
msgid "Enable Deposit Scheme"
msgstr "Pfandsystem aktivieren"

#: src/Admin/SettingsPage.php:114
msgid "Activate container deposit calculation and notices"
msgstr "Pfandberechnung und Hinweise aktivieren"

#: src/Admin/SettingsPage.php:119
msgid "Default Scheme"
msgstr "Standard-Pfandsystem"

#: src/Admin/SettingsPage.php:128
msgid "Default statutory scheme applied when destination matching is off or country is domestic."
msgstr "Gesetzliches Standard-Pfandsystem, das gilt, wenn die Zuordnung nach Zielland deaktiviert ist oder es sich um eine Inlandslieferung handelt."

#: src/Admin/SettingsPage.php:132
msgid "Cross-Border Destination Matching"
msgstr "Zuordnung nach Zielland"

#: src/Admin/SettingsPage.php:136
msgid "Automatically apply the destination country scheme (PL, RO, AT, DE, SK, HU) based on shipping address"
msgstr "Pfandsystem des Ziellands (PL, RO, AT, DE, SK, HU) automatisch anhand der Lieferadresse anwenden"

#: src/Admin/SettingsPage.php:141
msgid "Export Exemption"
msgstr "Ausnahme für Exporte"

#: src/Admin/SettingsPage.php:145
