#. Plugin Name of the plugin
#: botelix.php
msgid "Botelix - Deposit Return Scheme (Pfand, SGR, Kaucja, Zaloh)"
msgstr "Botelix - Deposit Return Scheme (Pfand, SGR, Kaucja, Zaloh)"

#. Plugin URI of the plugin
#: botelix.php
msgid "https://plogins.com/botelix/"
msgstr "https://plogins.com/botelix/"

#. Description of the plugin
#: botelix.php
msgid "Statutory container deposit scheme (DRS) calculations and checkout fees for European ecommerce (Pfand, SGR, Kaucja, Zaloh, Einwegpfand)."
msgstr "Cálculo del depósito legal de envases (SDDR) y cuotas al finalizar la compra para el comercio electrónico europeo (Pfand, SGR, Kaucja, Zaloh, Einwegpfand)."

#. Author of the plugin
#: botelix.php
msgid "WPPoland.com"
msgstr "WPPoland.com"

#. Author URI of the plugin
#: botelix.php
msgid "https://wppoland.com"
msgstr "https://wppoland.com"

#: botelix.php:48
msgid "Botelix - Deposit Return Scheme (Pfand, SGR, Kaucja, Zaloh) requires WooCommerce to be active."
msgstr "Botelix - Deposit Return Scheme (Pfand, SGR, Kaucja, Zaloh) necesita WooCommerce activo."

#: src/Admin/ProductMetaBox.php:45
msgid "Deposit Return Scheme (DRS / Pfand / Kaucja)"
msgstr "Sistema de depósito (SDDR / Pfand / Kaucja)"

#: src/Admin/ProductMetaBox.php:47
msgid "Store default scheme"
msgstr "Sistema por defecto de la tienda"

#: src/Admin/ProductMetaBox.php:54
msgid "Scheme override"
msgstr "Sistema específico del producto"

#: src/Admin/ProductMetaBox.php:55
msgid "Optionally lock this product to a specific national scheme, or leave as default."
msgstr "Opcionalmente, fija este producto a un sistema nacional concreto o déjalo con el valor por defecto."

#: src/Admin/ProductMetaBox.php:62 src/Admin/ProductMetaBox.php:134
msgid "Packaging container"
msgstr "Tipo de envase"

#: src/Admin/ProductMetaBox.php:63
msgid "Select the container type. Each national scheme charges its own rate for it, or nothing where it is not covered."
msgstr "Elige el tipo de envase. Cada sistema nacional cobra su propia tarifa por él, o nada si no lo cubre."

#: src/Admin/ProductMetaBox.php:71 src/Admin/ProductMetaBox.php:144
msgid "Container units"
msgstr "Unidades de envase"

#: src/Admin/ProductMetaBox.php:72
msgid "Number of covered containers in this item (e.g. 6 for a 6-pack). Defaults to 1."
msgstr "Número de envases sujetos a depósito en este artículo (p. ej., 6 para un pack de 6). Por defecto es 1."

#: src/Admin/ProductMetaBox.php:137
msgid "Leave empty to inherit the parent packaging container setting."
msgstr "Déjalo vacío para heredar el tipo de envase del producto principal."

#: src/Admin/ProductMetaBox.php:147
msgid "Containers in this variation."
msgstr "Envases en esta variación."

#: src/Admin/SettingsPage.php:34
msgid "Botelix Deposit Return"
msgstr "Botelix - depósito de envases"

#: src/Admin/SettingsPage.php:35
msgid "Deposit Return (DRS)"
msgstr "Depósito de envases (SDDR)"

#: src/Admin/SettingsPage.php:98
msgid "Botelix - Multi-Country Deposit Return Scheme (DRS)"
msgstr "Botelix - Sistema de depósito, devolución y retorno multipaís (SDDR)"

#: src/Admin/SettingsPage.php:100
msgid "Configure statutory container deposit schemes for European ecommerce (Pfand, SGR, Kaucja, Záloh, Visszaváltási díj)."
msgstr "Configura los sistemas legales de depósito de envases para el comercio electrónico europeo (Pfand, SGR, Kaucja, Záloh, Visszaváltási díj)."

#. translators: %s: store currency code, e.g. PLN
#: src/Admin/SettingsPage.php:111
#, php-format
msgid "These schemes charge nothing in this store. Their rates are set in law in their own currency, the store sells in %s, and Botelix does not convert currencies:"
msgstr "Estos sistemas no cobran nada en esta tienda. Sus tarifas están fijadas por ley en su propia moneda, la tienda vende en %s y Botelix no convierte monedas:"

#. translators: 1: scheme name, 2: scheme currency code, e.g. EUR
#: src/Admin/SettingsPage.php:120
#, php-format
msgid "%1$s (rates in %2$s)"
msgstr "%1$s (tarifas en %2$s)"

#: src/Admin/SettingsPage.php:136
msgid "Enable Deposit Scheme"
msgstr "Activar sistema de depósito"

#: src/Admin/SettingsPage.php:140
msgid "Activate container deposit calculation and notices"
msgstr "Activar el cálculo del depósito de envases y los avisos"

#: src/Admin/SettingsPage.php:145
msgid "Default Scheme"
msgstr "Sistema por defecto"

#: src/Admin/SettingsPage.php:154
msgid "Default statutory scheme applied when destination matching is off or country is domestic."
msgstr "Sistema legal por defecto que se aplica cuando la asignación por país de destino está desactivada o el envío es nacional."

#: src/Admin/SettingsPage.php:158
msgid "Cross-Border Destination Matching"
msgstr "Asignación por país de destino"

#: src/Admin/SettingsPage.php:162
msgid "Automatically apply the destination country scheme (PL, RO, AT, DE, SK, HU) based on shipping address"
msgstr "Aplicar automáticamente el sistema del país de destino (PL, RO, AT, DE, SK, HU) según la dirección de envío"

#: src/Admin/SettingsPage.php:167
msgid "Export Exemption"
msgstr "Exención para exportaciones"

#: src/Admin/SettingsPage.php:171
msgid "Do not charge container deposits when shipping outside covered deposit jurisdictions"
msgstr "No cobrar depósitos cuando el envío sale de los territorios con sistema de depósito"

#: src/Admin/SettingsPage.php:177
msgid "Statutory Schemes & Default Amounts"
msgstr "Sistemas legales e importes por defecto"

#: src/Admin/SettingsPage.php:182
msgid "Legal basis:"
msgstr "Base legal:"

#: src/Admin/SettingsPage.php:183
msgid "Tax status:"
msgstr "Estado fiscal:"

#: src/Admin/SettingsPage.php:183
msgid "Amount includes VAT: the fee is the net share and WooCommerce adds the tax back"
msgstr "El importe incluye IVA: la cuota es la parte neta y WooCommerce vuelve a sumar el impuesto"

#: src/Admin/SettingsPage.php:183
msgid "Non-taxable fee (outside VAT base)"
msgstr "Cuota no sujeta a impuestos (fuera de la base del IVA)"

#: src/Admin/SettingsPage.php:187
msgid "Fee Label"
msgstr "Etiqueta de la cuota"

#: src/Admin/SettingsPage.php:193
msgid "Product Notice Template"
msgstr "Plantilla del aviso de producto"

#. translators: %s is shown literally: a placeholder token merchants may type
#: src/Admin/SettingsPage.php:198
#, php-format
msgid "Leave empty for the default text shown in the field. Use {amount} or %s where the formatted deposit amount goes."
msgstr "Déjalo vacío para usar el texto predeterminado que se ve en el campo. Usa {amount} o %s donde va el importe del depósito con formato."

