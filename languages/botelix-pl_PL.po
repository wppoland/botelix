#. Plugin Name of the plugin
#: botelix.php
msgid "Botelix - Deposit Return Scheme (Pfand, SGR, Kaucja, Zaloh)"
msgstr "Botelix - Deposit Return Scheme (Pfand, SGR, Kaucja, Zaloh)"

#. Plugin URI of the plugin
#: botelix.php
msgid "https://plogins.com/botelix/"
msgstr "https://plogins.com/botelix/"

#. Description of the plugin
#: botelix.php
msgid "Statutory container deposit scheme (DRS) calculations and checkout fees for European ecommerce (Pfand, SGR, Kaucja, Zaloh, Einwegpfand)."
msgstr "Naliczanie ustawowej kaucji za opakowania (system kaucyjny, DRS) i opłaty w zamówieniu dla europejskiego e-commerce (Pfand, SGR, Kaucja, Zaloh, Einwegpfand)."

#. Author of the plugin
#: botelix.php
msgid "WPPoland.com"
msgstr "WPPoland.com"

#. Author URI of the plugin
#: botelix.php
msgid "https://wppoland.com"
msgstr "https://wppoland.com"

#: botelix.php:48
msgid "Botelix - Deposit Return Scheme for WooCommerce requires WooCommerce to be active."
msgstr "Botelix - Deposit Return Scheme for WooCommerce wymaga aktywnej wtyczki WooCommerce."

#: src/Admin/ProductMetaBox.php:41
msgid "Deposit Return Scheme (DRS / Pfand / Kaucja)"
msgstr "System kaucyjny (DRS / Pfand / Kaucja)"

#: src/Admin/ProductMetaBox.php:43
msgid "Store default scheme"
msgstr "Domyślny system sklepu"

#: src/Admin/ProductMetaBox.php:50
msgid "Scheme override"
msgstr "System kaucyjny produktu"

#: src/Admin/ProductMetaBox.php:51
msgid "Optionally lock this product to a specific national scheme, or leave as default."
msgstr "Opcjonalnie przypisz ten produkt na stałe do konkretnego systemu krajowego lub pozostaw ustawienie domyślne."

#: src/Admin/ProductMetaBox.php:58 src/Admin/ProductMetaBox.php:129
msgid "Packaging container"
msgstr "Rodzaj opakowania"

#: src/Admin/ProductMetaBox.php:59
msgid "Select the covered container type to add the statutory deposit at checkout."
msgstr "Wybierz rodzaj opakowania objętego systemem, aby doliczyć ustawową kaucję przy składaniu zamówienia."

#: src/Admin/ProductMetaBox.php:66 src/Admin/ProductMetaBox.php:139
msgid "Container units"
msgstr "Liczba opakowań"

#: src/Admin/ProductMetaBox.php:67
msgid "Number of covered containers in this item (e.g. 6 for a 6-pack). Defaults to 1."
msgstr "Liczba opakowań objętych kaucją w tej pozycji (np. 6 dla zgrzewki 6 sztuk). Domyślnie 1."

#: src/Admin/ProductMetaBox.php:132
msgid "Leave empty to inherit the parent packaging container setting."
msgstr "Pozostaw puste, aby użyć rodzaju opakowania z produktu nadrzędnego."

#: src/Admin/ProductMetaBox.php:142
msgid "Containers in this variation."
msgstr "Liczba opakowań w tym wariancie."

