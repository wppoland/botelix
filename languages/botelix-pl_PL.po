#: src/Admin/SettingsPage.php:141
msgid "Export Exemption"
msgstr "Zwolnienie przy wysyłce za granicę"

#: src/Admin/SettingsPage.php:145
msgid "Do not charge container deposits when shipping outside covered deposit jurisdictions"
msgstr "Nie pobieraj kaucji przy wysyłce poza kraje objęte systemem kaucyjnym"

